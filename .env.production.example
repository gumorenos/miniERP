POSTGRES_USER=minierp
POSTGRES_PASSWORD=replace-with-long-random-secret
POSTGRES_DB=minierp
APP_HOST_PORT=3010
SESSION_TTL_DAYS=30

# Bootstrap/emergency-only credentials. They are consumed by the one-shot
# bootstrap-user service, not by the long-running application container.
# After the initial user is created, blank APP_USER_EMAIL and APP_USER_PASSWORD
# in the real server env. The user manages name/email/password inside the app.
APP_USER_EMAIL=replace@example.com
APP_USER_PASSWORD=replace-with-long-random-secret
APP_BUSINESS_NAME=Taller
APP_USER_FORCE_PASSWORD_CHANGE=true
